theme = "Kanagawa Dragon"

font-family = "JetBrains Mono NL"
font-size = 14.0
font-thicken = true

mouse-hide-while-typing = true

# Don't dim inactive splits; nvim signals focus via cursorline instead
unfocused-split-opacity = 1

keybind = cmd+shift+i=prompt_tab_title
keybind = cmd+ctrl+i=prompt_surface_title

# Terminfo - SSH
# See: https://ghostty.org/docs/help/terminfo#ssh
## copy the terminfo entry the first time you log into a new server over SSH
shell-integration-features = ssh-terminfo,ssh-env

